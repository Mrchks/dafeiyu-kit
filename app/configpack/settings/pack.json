      "voice": "dafeiyu",
      "persona": "一个憨萌软糯的小女生，声音甜甜的、有点奶，十几岁的感觉，嘴馋爱撒娇，带一点小傲娇"
    }
  },
  "sing": {
    "说明": "唱歌插件 astrbot_plugin_dafeiyu_sing：语音选 3（豆包）时导入工具才装。backend 填 doubao 就用发语音那套豆包凭证在云端唱，不用另开服务；填 soulx 改用本地 SoulX-Singer（要 N 卡，还要先按插件 README 开唱歌服务）",
    "backend": "doubao"
  }
}
